<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF3E0"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings"
            android:textColor="#0B3273"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/settings_subtitle"
            android:textColor="#555555"
            android:textSize="15sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchNotifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:padding="12dp"
            android:text="@string/enable_notifications"
            android:textColor="#0B3273"
            android:textSize="17sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/default_payment"
            android:textColor="#0B3273"
            android:textSize="18sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/radioGroupDefaultPayment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <RadioButton
                android:id="@+id/radioDefaultCash"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:padding="12dp"
                android:text="@string/cash"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/radioDefaultCard"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:padding="12dp"
                android:text="@string/card"
                android:textSize="16sp" />
        </RadioGroup>

        <!-- Language (multi-language support) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/language"
            android:textColor="#0B3273"
            android:textSize="18sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/radioGroupLanguage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <RadioButton
                android:id="@+id/radioLangEn"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:padding="12dp"
                android:text="@string/lang_en"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/radioLangZu"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:padding="12dp"
                android:text="@string/lang_zu"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/radioLangXh"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:padding="12dp"
                android:text="@string/lang_xh"
                android:textSize="16sp" />
        </RadioGroup>

        <Button
            android:id="@+id/btnSaveSettings"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="25dp"
            android:backgroundTint="#F7941D"
            android:text="@string/save_settings"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>